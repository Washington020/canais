{
  "expo": {
    "name": "LuxePass",
    "slug": "luxepass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D17"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luxepass.app",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0D17"
      },
      "package": "com.luxepass.app",
      "versionCode": 1,
      "jsEngine": "jsc"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0D17"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8B5CF6",
          "defaultChannel": "luxepass-notifications",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "luxepass",
    "extra": {
      "eas": {
        "projectId": "fdc7f0cf-d174-498e-959e-1b404b9d0857"
      },
      "EXPO_PUBLIC_BACKEND_URL": "https://gymaccess-1.preview.emergentagent.com",
      "EXPO_PUBLIC_AGORA_APP_ID": "a727273c92974c7480bd48e033e0fbec"
    },
    "owner": "wotho"
  }
}
