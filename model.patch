+#!/usr/bin/env python3
+"""
+Test successful gym registration with unique data
+"""
+
+import requests
+import json
+import random
+from datetime import datetime
+
+# Get backend URL from environment
+BACKEND_URL = "https://trainer-portal-11.preview.emergentagent.com/api"
+
+def test_unique_gym_registration():
+    """Test successful gym registration with unique CNPJ"""
+    
+    # Admin login
+    response = requests.post(f"{BACKEND_URL}/auth/login", json={
+        "email": "admin@luxepass.com",
+        "password": "admin123"
+    })
+    
+    if response.status_code != 200:
+        print(f"❌ Admin login failed: {response.status_code}")
+        return
+    
+    admin_token = response.json().get("access_token")
+    print("✅ Admin authentication successful")
